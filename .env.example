PORT=3000

# ===== 小码（必填，团队级 API key，只在服务端）=====
XIAOMARK_API_KEY=

# 同步引擎：默认开启；SYNC_TICK_MS 每轮间隔（毫秒），SYNC_CONCURRENCY 对小码的并发上限
SYNC_ENABLED=true
SYNC_TICK_MS=300000
SYNC_CONCURRENCY=2

# 小码 webhook（可选）：在小码后台「短链 > API 短链 > API 设置」把回调地址填成 https://<域名>/api/webhooks/xiaomark，
# 并把那里设置的签名 token 填到这里；留空则 /api/webhooks/xiaomark 返回 404。
XIAOMARK_WEBHOOK_TOKEN=
# 收到的事件原样转发到这个地址（例如原来接在小码上的飞书 AnyCross 触发器），留空不转发
WEBHOOK_RELAY_URL=

# 管理员：逗号分隔的飞书 open_id（可改分组归属、改派短链、看同步状态与额度）
ADMIN_FEISHU_OPEN_IDS=

# 每人每月可新建的短链条数（认领来的不算）；管理员可在设置页单独调整某人
DEFAULT_MONTHLY_QUOTA=100
# 额度用完时弹窗里写的联系人
QUOTA_CONTACT_NAME=Gary

# 数据库文件路径（相对项目根），默认 shorturl.db
DB_PATH=shorturl.db

# /go 跳转代理额外允许的短链域名（自有域名与 sourl.cn 已自动允许）
ALLOWED_GO_HOSTS=

# ===== 飞书 OAuth（单应用统一登录，必填）=====
FEISHU_FBIF_APP_ID=
FEISHU_FBIF_APP_SECRET=
# 部署根 URL（不带路径）
FEISHU_REDIRECT_BASE=https://shorturl.garyzheng.com
# 可选：逗号分隔 tenant_key 白名单，默认空 = 不限制
# FEISHU_ALLOWED_TENANT_KEYS=
