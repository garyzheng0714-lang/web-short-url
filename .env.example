PORT=3000

# 推荐在服务端配置，前端页面就不需要再手动填 apikey
XIAOMARK_API_KEY=

# 前端“更多选项”里展示/记录用，不会提交给创建短链接口
DEFAULT_WEBHOOK_CALLBACK_URL=
DEFAULT_WEBHOOK_SCENE=

# 元数据（项目/分组/自有域名）服务端缓存时长（毫秒）
XIAOMARK_CACHE_TTL_MS=30000

# ===== 飞书 OAuth（单应用统一登录，必填） =====
# 登录 App（去 https://open.feishu.cn/app 用 FBIF 管理员账号建）。
# 富的员工无需单独的 App——在飞书管理后台开「关联组织应用共享」，把这个 App 共享给富的即可，
# 两家企业走同一个 App、同一条登录链路，靠 user_info 返回的 tenant_key 区分身份。
FEISHU_FBIF_APP_ID=
FEISHU_FBIF_APP_SECRET=

# 部署根 URL（不带路径）。本项目线上域名：
FEISHU_REDIRECT_BASE=https://shorturl.garyzheng.com

# 可选：逗号分隔 tenant_key 白名单。默认空 = 关闭。
# ⚠️ 单应用下 FBIF 和富的是两个不同 tenant_key，要开必须两个都填，只填一个会把另一家全拦掉。
# FEISHU_ALLOWED_TENANT_KEYS=
