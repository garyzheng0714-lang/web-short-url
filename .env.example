PORT=3000

# 推荐在服务端配置，前端页面就不需要再手动填 apikey
XIAOMARK_API_KEY=

# 前端“更多选项”里展示/记录用，不会提交给创建短链接口
DEFAULT_WEBHOOK_CALLBACK_URL=
DEFAULT_WEBHOOK_SCENE=

# 元数据（项目/分组/自有域名）服务端缓存时长（毫秒）
XIAOMARK_CACHE_TTL_MS=30000

# ===== 飞书 OAuth（FBIF + 富的 双租户，必填） =====
# FBIF 主企业 App（去 https://open.feishu.cn/app 用 FBIF 管理员账号建）
FEISHU_FBIF_APP_ID=
FEISHU_FBIF_APP_SECRET=

# 富的文化传媒（上海）有限公司 App — 跨项目共享，secret 不变就用这个默认值
FEISHU_FUDE_APP_ID=cli_a975bf6e72b95bc9
FEISHU_FUDE_APP_SECRET=MAXuPOlGRrvbO234gZyvObLbXBo5PKY4

# 部署根 URL（不带路径）。例如 https://shorturl.garyzheng.com 或 http://localhost:3000（仅本地开发）
FEISHU_REDIRECT_BASE=

# 可选：逗号分隔 tenant_key 白名单。默认空 = 关闭。
# FEISHU_ALLOWED_TENANT_KEYS=
